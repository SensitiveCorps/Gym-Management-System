# Copy to .env, then enter your own LOCAL PostgreSQL connection.
DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@localhost:5432/gym_management_system
HOST=127.0.0.1
PORT=8000
NODE_ENV=development
# Explicit working defaults requiring client confirmation (SRS D07/D11).
LOCK_MINUTES=15
IDLE_MINUTES=15
AUTO_CHECKOUT=false
EXPIRY_POLICY_APPROVED=false
# For a production reverse proxy only: HTTPS public origin and a trusted single proxy.
# APP_ORIGIN=https://gym.example.org
# TRUST_PROXY=1
